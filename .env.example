# ---- LLM (provider switch: groq | openrouter | openai-compatible) ----
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_API_KEY=ollama

# ---- Walrus Memory (get these at https://memory.walrus.xyz) ----
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# ---- App ----
AUTH_SECRET=  # any long random string: openssl rand -hex 32
# Neon Postgres. Leave empty to use a local JSON file store (.data/) for development.
DATABASE_URL=
